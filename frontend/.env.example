# Supabase (server-side only - do NOT prefix with NEXT_PUBLIC_, this is the
# service_role key and must never reach the browser). The frontend reads
# articles/twitter_posts directly from Supabase via app/lib/data.ts - see
# app/api/news and app/api/twitter Route Handlers. Get these from your
# Supabase project: Settings > API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key
