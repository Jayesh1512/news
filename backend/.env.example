# Database - Supabase Postgres (no local Postgres container).
# Get this from your Supabase project: Settings > Database > Connection
# string > URI. Use the "Connection pooling" (pgbouncer, port 6543)
# string if available - better suited to short-lived app connections than
# the direct connection (port 5432).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# Supabase client (stores scraped Twitter/X posts via the Supabase REST
# API / supabase-py - separate from DATABASE_URL above, which SQLAlchemy
# uses directly for RSS articles). Get these from Settings > API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key
SUPABASE_TWITTER_TABLE=twitter_posts

# Redis (host port 8500 when using docker-compose.redis.yml)
REDIS_URL=redis://localhost:8500/0

# API Settings
API_TITLE=News Aggregator API
API_VERSION=0.1.0
CORS_ORIGINS=http://localhost:8502

# Twitter/X Configuration (required for the Twitter scrape job - see
# app/core/constants.py for the account list, twitter-cli needs cookie auth)
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
TWITTER_POSTS_PER_ACCOUNT=20

# Scraping Settings
SCRAPE_INTERVAL_MINUTES=15
SCRAPE_TWITTER_INTERVAL_HOURS=6
MAX_ARTICLES_PER_SOURCE=50
