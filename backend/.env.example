# Shared local JSON datastore for RSS articles, sources, X posts and replies.
JSON_DATA_PATH=../data/news.json

# Redis (host port 8500 when using docker-compose.redis.yml)
REDIS_URL=redis://localhost:8500/0

# API Settings
API_TITLE=News Aggregator API
API_VERSION=0.1.0
CORS_ORIGINS=http://localhost:8502

# Twitter/X Configuration. The query accepts normal X search syntax, e.g.
# TWITTER_SEARCH_QUERY="drone delivery" lang:en -filter:retweets
# Leave it empty to disable the scheduled X search task.
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
TWITTER_SEARCH_QUERY=
TWITTER_TOPIC_SCRAPER_ENABLED=true
TWITTER_SEARCH_RESULTS=10
TWITTER_SEARCH_TYPE=latest
# Max conversation replies to pull for each matching search result.
TWITTER_REPLIES_PER_POST=20
TWITTER_REQUEST_DELAY_SECONDS=2

# Analyze every unique author found in the topic's root posts and replies.
# This can run automatically after a topic scrape, on demand through the API,
# or as the standalone analyze_twitter_profiles Celery task.
TWITTER_PROFILE_ANALYSIS_AFTER_SCRAPE=false
# Defaults to TWITTER_SEARCH_QUERY when empty.
TWITTER_PROFILE_TOPIC=
# A broader semantic description improves cosine matching. Defaults to topic.
TWITTER_PROFILE_TOPIC_DESCRIPTION=
TWITTER_PROFILE_POSTS_PER_AUTHOR=15
TWITTER_PROFILE_SIMILARITY_THRESHOLD=0.60
TWITTER_PROFILE_EMBEDDING_MODEL=text-embedding-3-large
# text-embedding-3 models support configurable dimensions.
TWITTER_PROFILE_EMBEDDING_DIMENSIONS=3072
TWITTER_PROFILE_SUMMARY_MODEL=gpt-6-luna
TWITTER_PROFILE_REQUEST_DELAY_SECONDS=2


# OpenAI (required only for profile cosine matching)
OPENAI_API_KEY=

# Scraping Settings
SCRAPE_INTERVAL_MINUTES=15
SCRAPE_TWITTER_INTERVAL_HOURS=6
MAX_ARTICLES_PER_SOURCE=50
