# Database
DATABASE_URL=postgresql://newsuser:newspass@localhost:5432/newsdb

# Supabase (stores scraped Twitter/X posts - separate from the Postgres
# DATABASE_URL above, which backs RSS articles). Get these from your
# Supabase project's Settings > API page.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TWITTER_TABLE=twitter_posts

# Redis
REDIS_URL=redis://localhost:6379/0

# API Settings
API_TITLE=News Aggregator API
API_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Twitter/X Configuration (required for the Twitter scrape job - see
# app/core/constants.py for the account list, twitter-cli needs cookie auth)
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
TWITTER_POSTS_PER_ACCOUNT=20

# Scraping Settings
SCRAPE_INTERVAL_MINUTES=15
SCRAPE_TWITTER_INTERVAL_HOURS=6
MAX_ARTICLES_PER_SOURCE=50
