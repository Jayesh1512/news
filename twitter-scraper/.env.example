# Twitter Scraper Configuration

# Backend API endpoint
BACKEND_URL=http://backend:8000

# Twitter accounts to scrape (comma-separated, no @ symbol)
TWITTER_ACCOUNTS=elonmusk,OpenAI,verge,techcrunch,wired

# Scrape interval in seconds (default: 900 = 15 minutes)
SCRAPE_INTERVAL=900

# Optional: Twitter authentication (for better access)
# TWITTER_USERNAME=your_username
# TWITTER_PASSWORD=your_password
# TWITTER_AUTH_TOKEN=your_token
